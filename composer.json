{
    "name": "laravelplus/global-settings",
    "description": "A global settings management package for Laravel with admin panel support.",
    "keywords": [
        "laravel",
        "settings",
        "global-settings",
        "admin"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "LaravelPlus",
            "email": "info@laravelplus.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "spatie/laravel-permission": "^6.0|^7.0"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Required for the admin settings pages; without it the admin routes are not registered.",
        "spatie/laravel-permission": "Optional: the default admin gate allows users with the super-admin or admin role."
    },
    "autoload": {
        "psr-4": {
            "LaravelPlus\\GlobalSettings\\": "src/"
        },
        "classmap": [
            "database/seeders"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPlus\\GlobalSettings\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPlus\\GlobalSettings\\GlobalSettingsServiceProvider"
            ],
            "aliases": {
                "GlobalSettings": "LaravelPlus\\GlobalSettings\\Facades\\GlobalSettings"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
